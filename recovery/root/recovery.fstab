#
# OrangeFox / TWRP fstab for the OnePlus PYS110 (OP68F7L1, mt6878).
#
# Format is the "v2" Android layout:
#   <src> <mnt_point> <type> <mnt_flags and options> <twrp flags>
# A bare partition name (or a /dev/... path) in the first column is required:
# TWRP only treats a line as v2 when the first column does NOT start with '/'
# (or does start with /dev/), see TWPartition::Process_Fstab_Line().
# Get this wrong and TWRP reads the mount point as the filesystem and the
# filesystem as the block device, then fails out of recovery.
#
# The TWRP-only flags (display=, backup=, flashimg=, slotselect, logical, ...)
# live in the 5th column, and are parsed with ',' as the separator.
#
# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                          <mnt_point>     <type>  <mnt_flags and options>                                                           <twrp flags>
system                          /system         erofs   ro                                                                wait,slotselect,logical
system_ext                      /system_ext     erofs   ro                                                                wait,slotselect,logical
vendor                          /vendor         erofs   ro                                                                wait,slotselect,logical
product                         /product        erofs   ro                                                                wait,slotselect,logical
odm                             /odm            erofs   ro                                                                wait,slotselect,logical
vendor_dlkm                     /vendor_dlkm    erofs   ro                                                                wait,slotselect,logical
odm_dlkm                        /odm_dlkm       erofs   ro                                                                wait,slotselect,logical
system_dlkm                     /system_dlkm    erofs   ro                                                                wait,slotselect,logical

# OPlus (OPPO/OnePlus/Realme) extra dynamic partitions
my_bigball                      /my_bigball     erofs   ro                                                                wait,slotselect,logical
my_carrier                      /my_carrier     erofs   ro                                                                wait,slotselect,logical
my_company                      /my_company     erofs   ro                                                                wait,slotselect,logical
my_engineering                  /my_engineering erofs   ro                                                                wait,slotselect,logical
my_heytap                       /my_heytap      erofs   ro                                                                wait,slotselect,logical
my_manifest                     /my_manifest    erofs   ro                                                                wait,slotselect,logical
my_preload                      /my_preload     erofs   ro                                                                wait,slotselect,logical
my_product                      /my_product     erofs   ro                                                                wait,slotselect,logical
my_region                       /my_region      erofs   ro                                                                wait,slotselect,logical
my_stock                        /my_stock       erofs   ro                                                                wait,slotselect,logical

# metadata / data.  The encryption flags themselves are in system/etc/twrp.flags.
/dev/block/by-name/metadata      /metadata      f2fs    noatime,nosuid,nodev,discard                                                     wait,check,formattable
/dev/block/by-name/userdata      /data          f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,resize

/dev/block/by-name/misc          /misc          emmc    defaults                                                                         defaults
/dev/block/by-name/persist       /persist       ext4    noatime,nosuid,nodev,barrier=1                                                   wait
